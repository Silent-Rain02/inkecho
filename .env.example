# 选择默认模型服务：custom_azure / ollama / openai / azure / compatible
INK_ECHO_PROVIDER=custom_azure

# 办公网自定义服务（AzureOpenAI 兼容）
INK_ECHO_CUSTOM_AZURE_API_KEY=replace_with_your_key
# 仅在本机 .env 中填写你的办公网端点；不要将内部域名提交到公开仓库
INK_ECHO_CUSTOM_AZURE_ENDPOINT=https://your-office-endpoint.example/v1
INK_ECHO_CUSTOM_AZURE_API_VERSION=2024-02-01
INK_ECHO_CUSTOM_AZURE_MODEL=gpt-5-mini-2025-08-07
INK_ECHO_CUSTOM_AZURE_LOGID=replace_with_your_logid

# Ollama：默认本机 http://127.0.0.1:11434/v1，可将模型名改成 qwen3:8b 或本地实际名称
INK_ECHO_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
INK_ECHO_OLLAMA_MODEL=qwen3:8b

# OpenAI 官方服务
INK_ECHO_OPENAI_API_KEY=replace_with_your_key
INK_ECHO_OPENAI_MODEL=gpt-5-mini

# 标准 Azure OpenAI
INK_ECHO_AZURE_API_KEY=replace_with_your_key
INK_ECHO_AZURE_ENDPOINT=https://your-resource.openai.azure.com/
INK_ECHO_AZURE_API_VERSION=2024-02-01
INK_ECHO_AZURE_MODEL=your-deployment-name
INK_ECHO_AZURE_LOGID=

# 其他 OpenAI-compatible 服务（vLLM / LM Studio / LocalAI 等）
INK_ECHO_COMPATIBLE_API_KEY=local
INK_ECHO_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
INK_ECHO_COMPATIBLE_MODEL=qwen3-8b

INK_ECHO_HOST=127.0.0.1
INK_ECHO_PORT=5173
# 上游模型请求超时（秒），范围 5-600，默认 120
INK_ECHO_REQUEST_TIMEOUT=120
# 最近对话历史字符预算，范围 8000-120000，默认 48000
INK_ECHO_HISTORY_BUDGET=48000

# 本地原作知识库：填写你自己的《蛊真人》纯文本路径，不要将原文提交到 GitHub
INK_ECHO_SOURCE_NAME=蛊真人
INK_ECHO_SOURCE_FILE=/absolute/path/to/新蛊无删减错别字修正5.0.txt
